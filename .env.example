# Copy to .env for local development and replace values locally.
# Never commit .env or real credentials.
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=documind
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
MAX_UPLOAD_BYTES=20971520
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
MAX_PDF_PAGES=500
MAX_EXTRACTED_TEXT_CHARS=5000000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CHUNK_TOKENS=220
EMBEDDING_CHUNK_OVERLAP=40
EMBEDDING_BATCH_SIZE=32
# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-with-a-long-random-value
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
RAG_TOP_K=6
RAG_MIN_RELEVANCE=0.25
